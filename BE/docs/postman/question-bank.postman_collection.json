              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examId\": {{examId}},\n  \"answers\": [\n    {\n      \"questionId\": {{questionId}},\n      \"selectedOptionIds\": [1]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/student/exams/attempts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "student", "exams", "attempts"]
