    {
      "name": "01 Question Management",
      "item": [
        {
          "name": "TC-Q01-01 List questions with filters",
          "event": [
            {
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has success true\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerAToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/manager/questions?courseId={{courseId}}&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "manager", "questions"],
              "query": [
                {"key": "courseId", "value": "{{courseId}}"},
                {"key": "page", "value": "0"},
                {"key": "size", "value": "20"}
              ]
            }
          }
        },
        {
          "name": "TC-Q02-01 Create Single Choice Question",
          "event": [
            {
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.questionId) {",
                  "    pm.environment.set(\"questionId\", jsonData.data.questionId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerAToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{courseId}},\n  \"moduleId\": {{moduleId}},\n  \"groupId\": {{groupId}},\n  \"questionType\": \"SINGLE_CHOICE\",\n  \"difficulty\": \"MEDIUM\",\n  \"content\": \"What is dependency injection in Spring Boot?\",\n  \"explanation\": \"DI is a design pattern used to implement IoC.\",\n  \"defaultPoints\": 2,\n  \"options\": [\n    {\"optionText\": \"A design pattern for IoC\", \"isCorrect\": true},\n    {\"optionText\": \"A database migration tool\", \"isCorrect\": false}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/manager/questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "manager", "questions"]
            }
          }
        },
        {
          "name": "TC-Q02-03 Create Question with Invalid Options -> 400",
          "event": [
            {
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerAToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{courseId}},\n  \"questionType\": \"SINGLE_CHOICE\",\n  \"difficulty\": \"EASY\",\n  \"content\": \"Invalid question without correct option\",\n  \"defaultPoints\": 1,\n  \"options\": [\n    {\"optionText\": \"Wrong 1\", \"isCorrect\": false},\n    {\"optionText\": \"Wrong 2\", \"isCorrect\": false}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/manager/questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "manager", "questions"]
            }
          }
        },
        {
          "name": "TC-Q04-01 Get Question Detail",
          "event": [
            {
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerAToken}}"
              }
            ],
