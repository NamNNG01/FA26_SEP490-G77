        {
          "name": "TC-AI-05 AI Quota Exceeded (Manager B)",
          "event": [
            {
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerBToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{courseId}},\n  \"questionType\": \"SINGLE_CHOICE\",\n  \"difficulty\": \"MEDIUM\",\n  \"count\": 10,\n  \"language\": \"en\",\n  \"context\": \"__TOKENS_HUGE__\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/manager/questions/ai/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "manager", "questions", "ai", "generate"]
            }
          }
        }
      ]
