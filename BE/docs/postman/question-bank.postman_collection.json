{
  "info": {
    "_postman_id": "exam-prep-question-bank-comprehensive-collection",
    "name": "ExamPrep Question Bank Comprehensive Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.environment.set(\"adminToken\", jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"]}
          }
        },
        {
          "name": "Login Manager A",
          "event": [
            {
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.environment.set(\"managerAToken\", jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{managerAEmail}}\",\n  \"password\": \"{{managerAPassword}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"]}
          }
        },
        {
          "name": "Login Student Enrolled",
          "event": [
            {
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.environment.set(\"studentToken\", jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"]}
          }
        }
      ]
    },
    {
      "name": "01 Question List (Q-01)",
      "item": [
        {
          "name": "List Questions by Course",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions?courseId={{courseId}}&page=0&size=20", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions"], "query": [{"key": "courseId", "value": "{{courseId}}"}, {"key": "page", "value": "0"}, {"key": "size", "value": "20"}]}
          }
        },
        {
          "name": "List Questions Filter by Type (DIAGRAM)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions?courseId={{courseId}}&questionType=DIAGRAM", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions"], "query": [{"key": "courseId", "value": "{{courseId}}"}, {"key": "questionType", "value": "DIAGRAM"}]}
          }
        },
        {
          "name": "List Questions Filter by Type (ORDERING)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions?courseId={{courseId}}&questionType=ORDERING", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions"], "query": [{"key": "courseId", "value": "{{courseId}}"}, {"key": "questionType", "value": "ORDERING"}]}
          }
        }
      ]
    },
    {
      "name": "02 Create Questions (Q-02)",
      "item": [
        {
          "name": "Create SINGLE_CHOICE Question",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{courseId}},\n  \"moduleId\": {{moduleId}},\n  \"questionType\": \"SINGLE_CHOICE\",\n  \"difficulty\": \"EASY\",\n  \"content\": \"What is 2 + 2?\",\n  \"defaultPoints\": 1,\n  \"options\": [\n    {\"optionText\": \"3\", \"isCorrect\": false},\n    {\"optionText\": \"4\", \"isCorrect\": true}\n  ]\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions"]}
          }
        },
        {
          "name": "Create DIAGRAM Question (Happy Path)",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{courseId}},\n  \"moduleId\": {{moduleId}},\n  \"questionType\": \"DIAGRAM\",\n  \"difficulty\": \"HARD\",\n  \"content\": \"Draw sequence diagram for login flow\",\n  \"defaultPoints\": 3,\n  \"questionMetadata\": {\n    \"drawioXml\": \"<mxfile><diagram>content</diagram></mxfile>\",\n    \"skillTag\": \"uml\"\n  }\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions"]}
          }
        },
        {
          "name": "Create ORDERING Question (Happy Path)",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{courseId}},\n  \"moduleId\": {{moduleId}},\n  \"questionType\": \"ORDERING\",\n  \"difficulty\": \"MEDIUM\",\n  \"content\": \"Order the HTTP methods by CRUD create\",\n  \"defaultPoints\": 2,\n  \"options\": [\n    {\"optionText\": \"POST\", \"isCorrect\": false, \"orderIndex\": 0},\n    {\"optionText\": \"GET\", \"isCorrect\": false, \"orderIndex\": 1}\n  ]\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions"]}
          }
        },
        {
          "name": "Create DIAGRAM Question (Invalid XML -> 400)",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{courseId}},\n  \"questionType\": \"DIAGRAM\",\n  \"difficulty\": \"HARD\",\n  \"content\": \"Invalid XML diagram\",\n  \"defaultPoints\": 3,\n  \"questionMetadata\": {\n    \"drawioXml\": \"<html>Invalid start</html>\"\n  }\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions"]}
          }
        },
        {
          "name": "Create ORDERING Question (isCorrect=true -> 400)",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{courseId}},\n  \"questionType\": \"ORDERING\",\n  \"difficulty\": \"MEDIUM\",\n  \"content\": \"Invalid ordering with isCorrect=true\",\n  \"defaultPoints\": 2,\n  \"options\": [\n    {\"optionText\": \"Step 1\", \"isCorrect\": true, \"orderIndex\": 0},\n    {\"optionText\": \"Step 2\", \"isCorrect\": false, \"orderIndex\": 1}\n  ]\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions"]}
          }
        }
      ]
    },
    {
      "name": "03 Detail, Update & Delete (Q-04 to Q-08)",
      "item": [
        {
          "name": "Get Question Detail (Q-04)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions/{{questionId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions", "{{questionId}}"]}
          }
        },
        {
          "name": "Update Question (Q-05)",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"content\": \"Updated question content\",\n  \"difficulty\": \"HARD\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions/{{questionId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions", "{{questionId}}"]}
          }
        },
        {
          "name": "Duplicate Question (Q-07)",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions/{{questionId}}/duplicate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions", "{{questionId}}", "duplicate"]}
          }
        },
        {
          "name": "Change Status (Q-08)",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"status\": \"INACTIVE\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions/{{questionId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions", "{{questionId}}", "status"]}
          }
        },
        {
          "name": "Delete Question (Q-06)",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions/{{questionId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions", "{{questionId}}"]}
          }
        }
      ]
    }
  ]
}
