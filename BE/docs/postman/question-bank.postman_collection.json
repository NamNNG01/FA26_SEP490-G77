{
  "info": {
    "_postman_id": "exam-prep-comprehensive-collection-v3",
    "name": "ExamPrep Comprehensive Collection (Questions & Exams)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Auth",
      "item": [
        {
          "name": "Login Manager A",
          "event": [
            {
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.environment.set(\"managerAToken\", jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{managerAEmail}}\",\n  \"password\": \"{{managerAPassword}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"]}
          }
        }
      ]
    },
    {
      "name": "01 Question Management",
      "item": [
        {
          "name": "List Questions",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions?courseId={{courseId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions"], "query": [{"key": "courseId", "value": "{{courseId}}"}]}
          }
        },
        {
          "name": "Create Single Choice Question",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{courseId}},\n  \"moduleId\": {{moduleId}},\n  \"questionType\": \"SINGLE_CHOICE\",\n  \"difficulty\": \"EASY\",\n  \"content\": \"What is 2 + 2?\",\n  \"options\": [\n    {\"optionText\": \"3\", \"isCorrect\": false},\n    {\"optionText\": \"4\", \"isCorrect\": true}\n  ]\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions"]}
          }
        },
        {
          "name": "Get Question Detail",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions/{{questionId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions", "{{questionId}}"]}
          }
        },
        {
          "name": "Update Question",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"content\": \"Updated question content\",\n  \"difficulty\": \"HARD\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions/{{questionId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions", "{{questionId}}"]}
          }
        },
        {
          "name": "Delete Question",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/manager/questions/{{questionId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "questions", "{{questionId}}"]}
          }
        }
      ]
    },
    {
      "name": "02 Exam Management",
      "item": [
        {
          "name": "List Exams",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/manager/exams?courseId={{courseId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "exams"], "query": [{"key": "courseId", "value": "{{courseId}}"}]}
          }
        },
        {
          "name": "Create Exam (with maxScore)",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Final Exam\",\n  \"courseId\": {{courseId}},\n  \"moduleId\": {{moduleId}},\n  \"durationMinutes\": 60,\n  \"isPractice\": false,\n  \"generationType\": \"STATIC\",\n  \"maxScore\": 10,\n  \"questionIds\": [\n    {\"questionId\": {{questionId}}, \"points\": 10, \"orderIndex\": 0}\n  ]\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/manager/exams", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "exams"]}
          }
        },
        {
          "name": "Get Exam Detail",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/manager/exams/{{examId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "exams", "{{examId}}"]}
          }
        },
        {
          "name": "Publish Exam",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"status\": \"PUBLISHED\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/manager/exams/{{examId}}/publish", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "exams", "{{examId}}", "publish"]}
          }
        },
        {
          "name": "Delete Exam",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{managerAToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/manager/exams/{{examId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "manager", "exams", "{{examId}}"]}
          }
        }
      ]
    }
  ]
}
