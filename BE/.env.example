# Copy this file to .env (or export these variables) before running the backend.
# Never commit real secrets.

# JWT signing secret - required, min 32 bytes for HMAC-SHA256
JWT_SECRET=change-me-to-a-long-random-256-bit-secret

# Database (Supabase PostgreSQL or local)
SUPABASE_DB_URL=jdbc:postgresql://<your-supabase-host>:5432/<db_name>?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=change-me

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
