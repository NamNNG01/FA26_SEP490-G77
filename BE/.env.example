# Copy this file to .env (or export these variables) before running the backend.
# Never commit real secrets.

# JWT signing secret - required, min 32 bytes for HMAC-SHA256
JWT_SECRET=change-me-to-a-long-random-256-bit-secret

# Database (Supabase PostgreSQL or local)
SUPABASE_DB_URL=jdbc:postgresql://<your-supabase-host>:5432/<db_name>?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=change-me

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (used to build the password-reset link in AUTH-06 email)
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_PATH=/reset-password

# Gmail SMTP for AUTH-06 (use a Gmail App Password, never your login password)
# See: https://support.google.com/accounts/answer/185833
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAIL_FROM=no-reply@examprep.local
MAIL_FROM_NAME=ExamPrep
